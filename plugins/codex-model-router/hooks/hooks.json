{
  "description": "Inject concise routing policy and worker-contract context for Codex subagent workflows.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/router_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\router_hook.py\"",
            "timeout": 10,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/router_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\router_hook.py\"",
            "timeout": 10,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/router_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\router_hook.py\"",
            "timeout": 10,
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
