{
  "description": "Inject execution-ownership routing and a bounded business-worker contract.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/router_hook.py\"",
            "commandWindows": "python \"%CLAUDE_PLUGIN_ROOT%\\hooks\\router_hook.py\"",
            "timeout": 10,
            "additionalContextLimit": 24576
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/router_hook.py\"",
            "commandWindows": "python \"%CLAUDE_PLUGIN_ROOT%\\hooks\\router_hook.py\"",
            "timeout": 10,
            "additionalContextLimit": 24576
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/router_hook.py\"",
            "commandWindows": "python \"%CLAUDE_PLUGIN_ROOT%\\hooks\\router_hook.py\"",
            "timeout": 10,
            "additionalContextLimit": 24576
          }
        ]
      }
    ]
  }
}
