{
  "description": "Inject a pure-orchestrator controller policy and bounded business-worker contract.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/router_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\router_hook.py\"",
            "timeout": 10,
            "additionalContextLimit": 24576
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/router_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\router_hook.py\"",
            "timeout": 10,
            "additionalContextLimit": 24576
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/router_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\router_hook.py\"",
            "timeout": 10,
            "additionalContextLimit": 24576
          }
        ]
      }
    ]
  }
}
