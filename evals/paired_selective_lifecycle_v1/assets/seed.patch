diff --git a/internal/config/storage_test.go b/internal/config/storage_test.go
new file mode 100644
index 0000000..ea19b69
--- /dev/null
+++ b/internal/config/storage_test.go
@@ -0,0 +1,45 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/oci"
+)
+
+func TestOCIAuthenticationDefaults(t *testing.T) {
+	for _, tt := range []struct {
+		name           string
+		authentication string
+		user           string
+		pass           string
+		wantErr        string
+	}{
+		{name: "username only", authentication: "username: user", user: "user"},
+		{name: "password only", authentication: "password: pass", pass: "pass"},
+		{name: "explicit static", authentication: "type: static, username: user, password: pass", user: "user", pass: "pass"},
+		{name: "empty type", authentication: "type: ''", wantErr: "oci authentication type is not supported"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			file := filepath.Join(t.TempDir(), "config.yml")
+			data := "storage:\n  type: oci\n  oci:\n    repository: some.target/repository/abundle:latest\n    authentication: {" + tt.authentication + "}\n"
+			require.NoError(t, os.WriteFile(file, []byte(data), 0600))
+			result, err := Load(file)
+			if tt.wantErr != "" {
+				require.EqualError(t, err, tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			auth := result.Config.Storage.OCI.Authentication
+			require.NotNil(t, auth)
+			assert.Equal(t, oci.AuthenticationTypeStatic, auth.Type)
+			assert.True(t, auth.Type.IsValid())
+			assert.Equal(t, tt.user, auth.Username)
+			assert.Equal(t, tt.pass, auth.Password)
+			require.NoError(t, result.Config.Storage.validate())
+		})
+	}
+}
