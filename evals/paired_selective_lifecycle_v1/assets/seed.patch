@@ -0,0 +1,76 @@
+package oci
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+	"oras.land/oras-go/v2"
+	"oras.land/oras-go/v2/registry/remote"
+	"oras.land/oras-go/v2/registry/remote/auth"
+)
+
+func TestAuthenticationTypeIsValid(t *testing.T) {
+	for _, tt := range []struct {
+		kind  AuthenticationType
+		valid bool
+	}{
+		{AuthenticationTypeStatic, true},
+		{AuthenticationTypeAWSECR, true},
+		{AuthenticationType("unknown"), false},
+		{AuthenticationType(""), false},
+	} {
+		t.Run(string(tt.kind), func(t *testing.T) {
+			assert.Equal(t, tt.valid, tt.kind.IsValid())
+		})
+	}
+}
+
+func TestWithCredentials(t *testing.T) {
+	for _, kind := range []AuthenticationType{AuthenticationTypeStatic, AuthenticationTypeAWSECR} {
+		t.Run(string(kind), func(t *testing.T) {
+			option, err := WithCredentials(kind, "user", "pass")
+			require.NoError(t, err)
+			var opts StoreOptions
+			option(&opts)
+			require.NotNil(t, opts.auth)
+			for _, registry := range []string{"registry.example.com", "another.example.com:5000"} {
+				credential := opts.auth(registry)
+				require.NotNil(t, credential)
+				if kind == AuthenticationTypeStatic {
+					got, err := credential(context.Background(), registry)
+					require.NoError(t, err)
+					assert.Equal(t, auth.Credential{Username: "user", Password: "pass"}, got)
+				}
+				got, err := credential(context.Background(), "unrelated.example.com")
+				require.NoError(t, err)
+				assert.Equal(t, auth.EmptyCredential, got)
+			}
+		})
+	}
+	option, err := WithCredentials(AuthenticationType("unknown"), "user", "pass")
+	require.EqualError(t, err, "unsupported auth type unknown")
+	assert.Nil(t, option)
+}
+
+func TestStoreStaticCredentials(t *testing.T) {
+	store, err := NewStore(zaptest.NewLogger(t), t.TempDir(), WithStaticCredentials("user", "pass"))
+	require.NoError(t, err)
+	ref, err := ParseReference("registry.example.com/bundle:latest")
+	require.NoError(t, err)
+	target, err := store.getTarget(ref)
+	require.NoError(t, err)
+	credential, err := target.(*remote.Repository).Client.(*auth.Client).Credential(context.Background(), ref.Registry)
+	require.NoError(t, err)
+	assert.Equal(t, auth.Credential{Username: "user", Password: "pass"}, credential)
+}
+
+func TestWithManifestVersion(t *testing.T) {
+	store, err := NewStore(zaptest.NewLogger(t), t.TempDir())
+	require.NoError(t, err)
+	assert.Equal(t, oras.PackManifestVersion1_1, store.opts.manifestVersion)
+	WithManifestVersion(oras.PackManifestVersion1_0)(&store.opts)
+	assert.Equal(t, oras.PackManifestVersion1_0, store.opts.manifestVersion)
+}
