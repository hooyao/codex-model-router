+package ecr
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/aws/aws-sdk-go-v2/service/ecr"
+	"github.com/aws/aws-sdk-go-v2/service/ecr/types"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"oras.land/oras-go/v2/registry/remote/auth"
+)
+
+var _ Client = (*MockClient)(nil)
+
+func TestFetchCredential(t *testing.T) {
+	clientErr := errors.New("ECR unavailable")
+	response := func(token string) *ecr.GetAuthorizationTokenOutput {
+		return &ecr.GetAuthorizationTokenOutput{
+			AuthorizationData: []types.AuthorizationData{{AuthorizationToken: &token}},
+		}
+	}
+	for _, tt := range []struct {
+		name      string
+		output    *ecr.GetAuthorizationTokenOutput
+		clientErr error
+		want      auth.Credential
+		wantErr   error
+	}{
+		{name: "client error", clientErr: clientErr, wantErr: clientErr},
+		{name: "nil output", wantErr: ErrNoAWSECRAuthorizationData},
+		{name: "no authorization data", output: &ecr.GetAuthorizationTokenOutput{}, wantErr: ErrNoAWSECRAuthorizationData},
+		{name: "nil token", output: &ecr.GetAuthorizationTokenOutput{AuthorizationData: []types.AuthorizationData{{}}}, wantErr: auth.ErrBasicCredentialNotFound},
+		{name: "empty token", output: response(""), wantErr: auth.ErrBasicCredentialNotFound},
+		{name: "invalid base64", output: response("!invalid"), wantErr: base64.CorruptInputError(0)},
+		{name: "missing separator", output: response(base64.StdEncoding.EncodeToString([]byte("userpass"))), wantErr: auth.ErrBasicCredentialNotFound},
+		{name: "valid token", output: response(base64.StdEncoding.EncodeToString([]byte("AWS:password"))), want: auth.Credential{Username: "AWS", Password: "password"}},
+		{name: "password with colon", output: response(base64.StdEncoding.EncodeToString([]byte("user:pass:word"))), want: auth.Credential{Username: "user", Password: "pass:word"}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			client := NewMockClient(t)
+			client.On("GetAuthorizationToken", ctx, &ecr.GetAuthorizationTokenInput{}).Return(tt.output, tt.clientErr).Once()
+			provider := ECR{client: client}
+			credential, err := provider.fetchCredential(ctx)
+			assert.Equal(t, tt.want, credential)
+			assert.Equal(t, tt.wantErr, err)
+		})
+	}
+}
+
+func TestFetchCredentialRefreshesToken(t *testing.T) {
+	ctx := context.Background()
+	client := NewMockClient(t)
+	provider := ECR{client: client}
+	for _, password := range []string{"first", "refreshed"} {
+		token := base64.StdEncoding.EncodeToString([]byte("AWS:" + password))
+		client.On("GetAuthorizationToken", ctx, &ecr.GetAuthorizationTokenInput{}).Return(&ecr.GetAuthorizationTokenOutput{
+			AuthorizationData: []types.AuthorizationData{{AuthorizationToken: &token}},
+		}, nil).Once()
+		credential, err := provider.fetchCredential(ctx)
+		require.NoError(t, err)
+		assert.Equal(t, password, credential.Password)
+	}
+}
+
+func TestCredentialAWSConfigurationErrors(t *testing.T) {
+	for _, name := range []string{"missing profile", "missing credentials"} {
+		t.Run(name, func(t *testing.T) {
+			for _, env := range os.Environ() {
+				key, _, _ := strings.Cut(env, "=")
+				if strings.HasPrefix(key, "AWS_") {
+					t.Setenv(key, "")
+				}
+			}
+			dir := t.TempDir()
+			t.Setenv("AWS_CONFIG_FILE", filepath.Join(dir, "config"))
+			t.Setenv("AWS_SHARED_CREDENTIALS_FILE", filepath.Join(dir, "credentials"))
+			t.Setenv("AWS_EC2_METADATA_DISABLED", "true")
+			t.Setenv("AWS_REGION", "us-east-1")
+			if name == "missing profile" {
+				t.Setenv("AWS_PROFILE", "nonexistent")
+			}
+			provider := &ECR{}
+			credential, err := provider.Credential(context.Background(), "registry.example.com")
+			require.Error(t, err)
+			assert.Equal(t, auth.EmptyCredential, credential)
+			if name == "missing profile" {
+				assert.Nil(t, provider.client)
+			}
+		})
+	}
+}
