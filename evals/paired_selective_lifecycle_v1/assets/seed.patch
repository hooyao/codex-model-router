diff --git a/internal/oci/ecr/ecr.go b/internal/oci/ecr/ecr.go
new file mode 100644
index 0000000..2717bcb
--- /dev/null
+++ b/internal/oci/ecr/ecr.go
@@ -0,0 +1,77 @@
+package ecr
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+	"strings"
+	"sync"
+
+	"github.com/aws/aws-sdk-go-v2/config"
+	"github.com/aws/aws-sdk-go-v2/service/ecr"
+	"oras.land/oras-go/v2/registry/remote/auth"
+)
+
+// ErrNoAWSECRAuthorizationData indicates that ECR returned no authorization data.
+var ErrNoAWSECRAuthorizationData = errors.New("no AWS ECR authorization data")
+
+// Client is the ECR API used to retrieve registry credentials.
+//
+//go:generate mockery --name Client --filename mock_client.go --inpackage --output .
+type Client interface {
+	GetAuthorizationToken(ctx context.Context, params *ecr.GetAuthorizationTokenInput, optFns ...func(*ecr.Options)) (*ecr.GetAuthorizationTokenOutput, error)
+}
+
+// ECR resolves registry credentials using the default AWS configuration chain.
+type ECR struct {
+	mu     sync.Mutex
+	client Client
+}
+
+// CredentialFunc returns an ORAS credential resolver for registry.
+func (e *ECR) CredentialFunc(registry string) auth.CredentialFunc {
+	return func(ctx context.Context, hostport string) (auth.Credential, error) {
+		if hostport != registry {
+			return auth.EmptyCredential, nil
+		}
+		return e.Credential(ctx, hostport)
+	}
+}
+
+// Credential loads AWS configuration and retrieves current ECR registry credentials.
+func (e *ECR) Credential(ctx context.Context, hostport string) (auth.Credential, error) {
+	cfg, err := config.LoadDefaultConfig(ctx)
+	if err != nil {
+		return auth.EmptyCredential, err
+	}
+
+	// ORAS can request credentials concurrently for the same registry.
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.client = ecr.NewFromConfig(cfg)
+	return e.fetchCredential(ctx)
+}
+
+func (e *ECR) fetchCredential(ctx context.Context) (auth.Credential, error) {
+	output, err := e.client.GetAuthorizationToken(ctx, &ecr.GetAuthorizationTokenInput{})
+	if err != nil {
+		return auth.EmptyCredential, err
+	}
+	if output == nil || len(output.AuthorizationData) == 0 {
+		return auth.EmptyCredential, ErrNoAWSECRAuthorizationData
+	}
+
+	token := output.AuthorizationData[0].AuthorizationToken
+	if token == nil {
+		return auth.EmptyCredential, auth.ErrBasicCredentialNotFound
+	}
+	decoded, err := base64.StdEncoding.DecodeString(*token)
+	if err != nil {
+		return auth.EmptyCredential, err
+	}
+	user, pass, ok := strings.Cut(string(decoded), ":")
+	if !ok {
+		return auth.EmptyCredential, auth.ErrBasicCredentialNotFound
+	}
+	return auth.Credential{Username: user, Password: pass}, nil
+}
