diff --git a/internal/oci/ownership_test.go b/internal/oci/ownership_test.go
new file mode 100644
index 0000000..958b41b
--- /dev/null
+++ b/internal/oci/ownership_test.go
@@ -0,0 +1,121 @@
+package oci
+
+import (
+	"context"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+	"time"
+
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+	"oras.land/oras-go/v2"
+	"oras.land/oras-go/v2/content/oci"
+)
+
+type countingStream struct {
+	io.Reader
+	closes int
+}
+
+func (r *countingStream) Close() error { r.closes++; return errors.New("cleanup failure") }
+
+type failingTarget struct {
+	oras.ReadOnlyTarget
+	calls   int
+	fail    int
+	failure error
+	streams []*countingStream
+}
+
+func (s *failingTarget) Fetch(context.Context, v1.Descriptor) (io.ReadCloser, error) {
+	s.calls++
+	if s.calls == s.fail {
+		return nil, s.failure
+	}
+	stream := &countingStream{Reader: strings.NewReader(`{"namespace":"alpha"}`)}
+	s.streams = append(s.streams, stream)
+	return stream, nil
+}
+
+func TestFetchFilesClosesEarlierStreams(t *testing.T) {
+	sourceErr := errors.New("layer open failed")
+	for _, mode := range []string{"open", "media-type", "encoding"} {
+		t.Run(mode, func(t *testing.T) {
+			target := &failingTarget{fail: 2, failure: sourceErr}
+			manifest := v1.Manifest{Annotations: map[string]string{v1.AnnotationCreated: time.Now().UTC().Format(time.RFC3339)},
+				Layers: []v1.Descriptor{{MediaType: MediaTypeFliptNamespace}, {MediaType: MediaTypeFliptNamespace}}}
+			switch mode {
+			case "media-type":
+				manifest.Layers[1].MediaType = "invalid"
+			case "encoding":
+				manifest.Layers[1].MediaType = MediaTypeFliptNamespace + "+unsupported"
+			}
+			store, err := NewStore(zap.NewNop(), t.TempDir())
+			require.NoError(t, err)
+			files, err := store.fetchFiles(context.Background(), target, manifest)
+			require.Error(t, err)
+			require.Nil(t, files)
+			if mode == "open" {
+				require.ErrorIs(t, err, sourceErr)
+			}
+			require.Len(t, target.streams, 1)
+			require.Equal(t, 1, target.streams[0].closes)
+			target.calls, target.fail = 0, 0
+			manifest.Layers[1].MediaType = MediaTypeFliptNamespace
+			files, err = store.fetchFiles(context.Background(), target, manifest)
+			require.NoError(t, err)
+			require.Len(t, files, 2)
+			for _, file := range files {
+				_ = file.Close()
+			}
+			for _, stream := range target.streams {
+				require.Equal(t, 1, stream.closes)
+			}
+		})
+	}
+}
+
+func TestFetchSeparatesManifestIdentityAndContentDetector(t *testing.T) {
+	dir := testRepository(t, layer("alpha", `{"namespace":"alpha"}`, MediaTypeFliptNamespace))
+	target, err := oci.New(dir + "/" + repo)
+	require.NoError(t, err)
+	target.AutoSaveIndex = true
+	layerDesc := layer("beta", `{"namespace":"beta"}`, MediaTypeFliptNamespace)(t, target)
+	ctx := context.Background()
+	pack := func(note string) v1.Descriptor {
+		d, err := oras.PackManifest(ctx, target, oras.PackManifestVersion1_1_RC4, MediaTypeFliptFeatures,
+			oras.PackManifestOptions{Layers: []v1.Descriptor{layerDesc}, ManifestAnnotations: map[string]string{"note": note}})
+		require.NoError(t, err)
+		return d
+	}
+	one, two := pack("one"), pack("two")
+	require.NotEqual(t, one.Digest, two.Digest)
+	store, err := NewStore(zap.NewNop(), dir)
+	require.NoError(t, err)
+	ref, err := ParseReference("flipt://local/" + repo + ":stable")
+	require.NoError(t, err)
+	require.NoError(t, target.Tag(ctx, one, "stable"))
+	first, err := store.Fetch(ctx, ref)
+	require.NoError(t, err)
+	for _, file := range first.Files {
+		require.NoError(t, file.Close())
+	}
+	require.Equal(t, one.Digest, first.ManifestDigest)
+	require.NoError(t, target.Tag(ctx, two, "stable"))
+	second, err := store.Fetch(ctx, ref, IfNoMatch(first.Digest))
+	require.NoError(t, err)
+	require.True(t, second.Matched)
+	require.Empty(t, second.Files)
+	require.Equal(t, first.Digest, second.Digest)
+	require.Equal(t, two.Digest, second.ManifestDigest)
+	ref.Reference.Reference = two.Digest.String()
+	second, err = store.Fetch(ctx, ref)
+	require.NoError(t, err)
+	for _, file := range second.Files {
+		require.NoError(t, file.Close())
+	}
+	require.Equal(t, two.Digest, second.ManifestDigest)
+}
diff --git a/internal/storage/fs/oci/reference_test.go b/internal/storage/fs/oci/reference_test.go
new file mode 100644
index 0000000..b03a1f8
--- /dev/null
+++ b/internal/storage/fs/oci/reference_test.go
@@ -0,0 +1,377 @@
+package oci
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	"go.flipt.io/flipt/internal/storage"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap/zaptest"
+	"oras.land/oras-go/v2"
+	"oras.land/oras-go/v2/content"
+	"oras.land/oras-go/v2/content/memory"
+)
+
+// registryFixture serves an OCI graph and can hold a resolved response behind
+// a channel. Its deadlines bound test failures, not production latency.
+type registryFixture struct {
+	mu          sync.Mutex
+	tags        map[string]v1.Descriptor
+	blobs       map[string][]byte
+	descriptors map[string]v1.Descriptor
+	hook        func(*http.Request, v1.Descriptor)
+	requests    int
+}
+
+func newRegistry(t *testing.T) (*registryFixture, *httptest.Server) {
+	t.Helper()
+	r := &registryFixture{tags: map[string]v1.Descriptor{}, blobs: map[string][]byte{}, descriptors: map[string]v1.Descriptor{}}
+	srv := httptest.NewServer(http.HandlerFunc(r.serve))
+	t.Cleanup(srv.Close)
+	return r, srv
+}
+
+func (r *registryFixture) add(t *testing.T, payloads ...string) v1.Descriptor {
+	t.Helper()
+	target := memory.New()
+	var layers []v1.Descriptor
+	for i, payload := range payloads {
+		layers = append(layers, layer(fmt.Sprintf("namespace-%d", i), payload, fliptoci.MediaTypeFliptNamespace)(t, target))
+	}
+	desc, err := oras.PackManifest(context.Background(), target, oras.PackManifestVersion1_1,
+		fliptoci.MediaTypeFliptFeatures, oras.PackManifestOptions{Layers: layers})
+	require.NoError(t, err)
+	data, err := content.FetchAll(context.Background(), target, desc)
+	require.NoError(t, err)
+	var manifest v1.Manifest
+	require.NoError(t, json.Unmarshal(data, &manifest))
+	all := append(append([]v1.Descriptor{desc, manifest.Config}, manifest.Layers...), layers...)
+	for _, d := range all {
+		data, err := content.FetchAll(context.Background(), target, d)
+		require.NoError(t, err)
+		r.mu.Lock()
+		r.blobs[d.Digest.String()], r.descriptors[d.Digest.String()] = data, d
+		r.mu.Unlock()
+	}
+	return desc
+}
+
+func (r *registryFixture) tag(name string, desc v1.Descriptor) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.tags[name] = desc
+}
+
+func (r *registryFixture) setHook(hook func(*http.Request, v1.Descriptor)) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.hook = hook
+}
+
+func (r *registryFixture) serve(w http.ResponseWriter, req *http.Request) {
+	key := req.URL.Path[strings.LastIndex(req.URL.Path, "/")+1:]
+	r.mu.Lock()
+	r.requests++
+	desc, ok := r.descriptors[key]
+	if !ok {
+		desc, ok = r.tags[key]
+	}
+	data := r.blobs[desc.Digest.String()]
+	hook := r.hook
+	r.mu.Unlock()
+	if !ok {
+		http.NotFound(w, req)
+		return
+	}
+	if hook != nil {
+		hook(req, desc)
+	}
+	w.Header().Set("Docker-Content-Digest", desc.Digest.String())
+	w.Header().Set("Content-Type", desc.MediaType)
+	w.Header().Set("Content-Length", strconv.Itoa(len(data)))
+	if req.Method != http.MethodHead {
+		_, _ = w.Write(data)
+	}
+}
+
+func remoteSnapshotStore(t *testing.T, srv *httptest.Server, opts ...containers.Option[SnapshotStore]) *SnapshotStore {
+	t.Helper()
+	backend, err := fliptoci.NewStore(zaptest.NewLogger(t), t.TempDir())
+	require.NoError(t, err)
+	ref, err := fliptoci.ParseReference(srv.URL + "/features:latest")
+	require.NoError(t, err)
+	s, err := NewSnapshotStore(context.Background(), zaptest.NewLogger(t), backend, ref,
+		append([]containers.Option[SnapshotStore]{WithPollOptions(storagefs.WithInterval(time.Hour))}, opts...)...)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, s.Close()) })
+	return s
+}
+
+func viewFlag(s *SnapshotStore, ctx context.Context, ref, key string) error {
+	return s.View(ctx, storage.Reference(ref), func(snapshot storage.ReadOnlyStore) error {
+		_, err := snapshot.GetFlag(ctx, storage.NewResource("production", key))
+		return err
+	})
+}
+
+func asyncFlag(s *SnapshotStore, ctx context.Context, ref, key string) <-chan error {
+	done := make(chan error, 1)
+	go func() { done <- viewFlag(s, ctx, ref, key) }()
+	return done
+}
+
+func resultWithin(t *testing.T, ch <-chan error) error {
+	t.Helper()
+	select {
+	case err := <-ch:
+		return err
+	case <-time.After(5 * time.Second):
+		t.Fatal("operation did not finish")
+		return nil
+	}
+}
+
+func signalWithin(t *testing.T, ch <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(5 * time.Second):
+		t.Fatal("operation did not reach barrier")
+	}
+}
+
+func TestReferenceValidation(t *testing.T) {
+	for _, valid := range []string{"latest", "_tag", "V1.2-beta", "sha256:" + strings.Repeat("a", 64), strings.Repeat("a", 128)} {
+		require.NoError(t, validateReference(valid), valid)
+	}
+	s, _ := testStore(t)
+	for _, invalid := range []string{".", "-tag", "../repo", "other/repo:tag", "https://host/repo:tag", "a@sha256:" + strings.Repeat("a", 64), "sha256:123", "sha512:" + strings.Repeat("a", 128), "sha256:" + strings.Repeat("A", 64), "tag?x=y", "tag#x", "tag%2fother", " tag", "tag\n", strings.Repeat("a", 129)} {
+		require.Error(t, s.View(context.Background(), storage.Reference(invalid), func(storage.ReadOnlyStore) error {
+			t.Error("invalid reference entered callback")
+			return nil
+		}), invalid)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.ErrorIs(t, s.View(ctx, "", func(storage.ReadOnlyStore) error { t.Error("cancelled callback"); return nil }), context.Canceled)
+}
+
+func TestReferenceAcquisitionIsolationAndIndependentCancellation(t *testing.T) {
+	r, srv := newRegistry(t)
+	old := r.add(t, `{"namespace":"production","flags":[{"key":"old","name":"Old"}]}`)
+	r.tag("latest", old)
+	r.tag("stable", old)
+	r.tag("canary", old)
+	s := remoteSnapshotStore(t, srv)
+	entered, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	defer once.Do(func() { close(release) })
+	r.setHook(func(req *http.Request, _ v1.Descriptor) {
+		if req.Method == http.MethodGet && strings.HasSuffix(req.URL.Path, "/stable") {
+			select {
+			case <-entered:
+			default:
+				close(entered)
+			}
+			select {
+			case <-release:
+			case <-req.Context().Done():
+			}
+		}
+	})
+	initiator, cancelInitiator := context.WithCancel(context.Background())
+	defer cancelInitiator()
+	waiter, cancelWaiter := context.WithCancel(context.Background())
+	defer cancelWaiter()
+	first := asyncFlag(s, initiator, "stable", "old")
+	signalWithin(t, entered)
+	second := asyncFlag(s, waiter, "stable", "old")
+	survivor := asyncFlag(s, context.Background(), "stable", "old")
+	require.Eventually(t, func() bool {
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		return s.inflight["stable"] != nil && s.inflight["stable"].waiters == 3
+	}, 5*time.Second, time.Millisecond)
+	// None of these operations depend on the held stable fetch.
+	require.NoError(t, resultWithin(t, asyncFlag(s, context.Background(), "", "old")))
+	require.NoError(t, resultWithin(t, asyncFlag(s, context.Background(), old.Digest.String(), "old")))
+	require.NoError(t, resultWithin(t, asyncFlag(s, context.Background(), "canary", "old")))
+	cancelInitiator()
+	require.ErrorIs(t, resultWithin(t, first), context.Canceled)
+	cancelWaiter()
+	require.ErrorIs(t, resultWithin(t, second), context.Canceled)
+	once.Do(func() { close(release) })
+	require.NoError(t, resultWithin(t, survivor))
+	r.setHook(nil)
+	newer := r.add(t, `{"namespace":"production","flags":[{"key":"new","name":"New"}]}`)
+	r.tag("stable", newer)
+	require.NoError(t, viewFlag(s, context.Background(), "stable", "new"))
+	require.NoError(t, viewFlag(s, context.Background(), "canary", "old"))
+	require.NoError(t, viewFlag(s, context.Background(), old.Digest.String(), "old"))
+}
+
+func TestReferenceFailureAtomicityAndRecovery(t *testing.T) {
+	r, srv := newRegistry(t)
+	old := r.add(t, `{"namespace":"production","flags":[{"key":"old","name":"Old"}]}`)
+	r.tag("latest", old)
+	r.tag("stable", old)
+	s := remoteSnapshotStore(t, srv)
+	require.NoError(t, viewFlag(s, context.Background(), "stable", "old"))
+	broken := r.add(t, `{"namespace":"production","flags":[{"key":"partial","name":"Partial"}]}`, `not-json`)
+	r.tag("latest", broken)
+	r.tag("stable", broken)
+	changed, err := s.update(context.Background())
+	require.Error(t, err)
+	require.False(t, changed)
+	require.NoError(t, viewFlag(s, context.Background(), "", "old"))
+	require.Error(t, viewFlag(s, context.Background(), "stable", "old"))
+	require.Error(t, viewFlag(s, context.Background(), "", "partial"))
+	require.NoError(t, viewFlag(s, context.Background(), old.Digest.String(), "old"))
+	newer := r.add(t, `{"namespace":"production","flags":[{"key":"new","name":"New"}]}`)
+	r.tag("latest", newer)
+	r.tag("stable", newer)
+	changed, err = s.update(context.Background())
+	require.NoError(t, err)
+	require.True(t, changed)
+	require.NoError(t, viewFlag(s, context.Background(), "", "new"))
+	require.NoError(t, viewFlag(s, context.Background(), "stable", "new"))
+}
+
+func TestReferenceRetentionAndCallbackPublication(t *testing.T) {
+	r, srv := newRegistry(t)
+	old := r.add(t, `{"namespace":"production","flags":[{"key":"old","name":"Old"}]}`)
+	r.tag("latest", old)
+	r.tag("held", old)
+	s := remoteSnapshotStore(t, srv)
+	entered, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	defer once.Do(func() { close(release) })
+	done := make(chan error, 1)
+	go func() {
+		done <- s.View(context.Background(), "held", func(snapshot storage.ReadOnlyStore) error {
+			close(entered)
+			<-release
+			_, err := snapshot.GetFlag(context.Background(), storage.NewResource("production", "old"))
+			return err
+		})
+	}()
+	signalWithin(t, entered)
+	var pending []<-chan error
+	for i := 0; i < 12; i++ {
+		key := fmt.Sprintf("flag-%d", i)
+		desc := r.add(t, fmt.Sprintf(`{"namespace":"production","flags":[{"key":%q,"name":"Flag"}]}`, key))
+		tag := fmt.Sprintf("tag-%d", i)
+		r.tag(tag, desc)
+		pending = append(pending, asyncFlag(s, context.Background(), tag, key))
+	}
+	for _, result := range pending {
+		require.NoError(t, resultWithin(t, result))
+	}
