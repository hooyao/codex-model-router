@@ -0,0 +1,87 @@
+package fs
+
+import (
+	"errors"
+	"io"
+	"io/fs"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+)
+
+type ownedFile struct {
+	io.Reader
+	statErr, closeErr error
+	closes            int
+}
+
+func (f *ownedFile) Close() error               { f.closes++; return f.closeErr }
+func (f *ownedFile) Stat() (fs.FileInfo, error) { return ownedInfo{}, f.statErr }
+
+type ownedInfo struct{}
+
+func (ownedInfo) Name() string       { return "flags.json" }
+func (ownedInfo) Size() int64        { return 0 }
+func (ownedInfo) Mode() fs.FileMode  { return 0444 }
+func (ownedInfo) ModTime() time.Time { return time.Time{} }
+func (ownedInfo) IsDir() bool        { return false }
+func (ownedInfo) Sys() any           { return nil }
+
+type readFailure struct{ err error }
+
+func (r readFailure) Read([]byte) (int, error) { return 0, r.err }
+
+func TestSnapshotOwnsEverySuppliedFile(t *testing.T) {
+	sentinel := errors.New("source failed")
+	for _, mode := range []string{"success", "stat", "read", "validation"} {
+		t.Run(mode, func(t *testing.T) {
+			first := &ownedFile{Reader: strings.NewReader(`{"namespace":"first"}`), closeErr: errors.New("close failed")}
+			next := &ownedFile{Reader: strings.NewReader(`{"namespace":"second"}`)}
+			later := &ownedFile{Reader: strings.NewReader(`{"namespace":"later"}`)}
+			switch mode {
+			case "stat":
+				next.statErr = sentinel
+			case "read":
+				next.Reader = readFailure{sentinel}
+			case "validation":
+				next.Reader = strings.NewReader(`{"namespace":"broken","flags":[{"key":"bad"}]}`)
+			}
+			snapshot, err := SnapshotFromFiles(zap.NewNop(), []fs.File{first, next, later})
+			if mode == "success" {
+				require.NoError(t, err)
+				require.NotNil(t, snapshot)
+			} else {
+				require.Error(t, err)
+				require.Nil(t, snapshot)
+			}
+			if mode == "stat" || mode == "read" {
+				require.ErrorContains(t, err, sentinel.Error())
+			}
+			for _, file := range []*ownedFile{first, next, later} {
+				require.Equal(t, 1, file.closes)
+			}
+		})
+	}
+}
+
+type openFailureFS struct {
+	first fs.File
+	err   error
+}
+
+func (s openFailureFS) Open(name string) (fs.File, error) {
+	if name == "first.json" {
+		return s.first, nil
+	}
+	return nil, s.err
+}
+func TestSnapshotPathsClosePreviouslyOpenedFiles(t *testing.T) {
+	sourceErr := errors.New("cannot open second file")
+	first := &ownedFile{Reader: strings.NewReader(`{"namespace":"first"}`), closeErr: errors.New("cleanup failed")}
+	_, err := SnapshotFromPaths(zap.NewNop(), openFailureFS{first, sourceErr}, []string{"first.json", "second.json"})
+	require.ErrorIs(t, err, sourceErr)
+	require.Equal(t, 1, first.closes)
+}
