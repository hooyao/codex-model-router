+	r.tag("latest", old)
+	r.tag("stable", old)
+	s := remoteSnapshotStore(t, srv, WithPollOptions(storagefs.WithInterval(10*time.Millisecond)))
+	held, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	defer once.Do(func() { close(release) })
+	callback := make(chan error, 1)
+	go func() {
+		callback <- s.View(context.Background(), "", func(snapshot storage.ReadOnlyStore) error {
+			close(held)
+			<-release
+			_, err := snapshot.GetFlag(context.Background(), storage.NewResource("production", "old"))
+			return err
+		})
+	}()
+	signalWithin(t, held)
+	pollEntered, fetchEntered := make(chan struct{}), make(chan struct{})
+	pollCancelled, fetchCancelled := make(chan struct{}), make(chan struct{})
+	var pollOnce, fetchOnce sync.Once
+	r.setHook(func(req *http.Request, _ v1.Descriptor) {
+		if req.Method != http.MethodGet {
+			return
+		}
+		if strings.HasSuffix(req.URL.Path, "/latest") {
+			pollOnce.Do(func() { close(pollEntered); <-req.Context().Done(); close(pollCancelled) })
+		}
+		if strings.HasSuffix(req.URL.Path, "/stable") {
+			fetchOnce.Do(func() { close(fetchEntered); <-req.Context().Done(); close(fetchCancelled) })
+		}
+	})
+	fetching := asyncFlag(s, context.Background(), "stable", "old")
+	signalWithin(t, fetchEntered)
+	signalWithin(t, pollEntered)
+	closed := make(chan error, 2)
+	go func() { closed <- s.Close() }()
+	go func() { closed <- s.Close() }()
+	require.NoError(t, resultWithin(t, closed))
+	require.NoError(t, resultWithin(t, closed))
+	require.ErrorIs(t, resultWithin(t, fetching), ErrClosed)
+	signalWithin(t, fetchCancelled)
+	signalWithin(t, pollCancelled)
+	require.ErrorIs(t, s.View(context.Background(), "", func(storage.ReadOnlyStore) error { t.Error("closed callback"); return nil }), ErrClosed)
+	r.mu.Lock()
+	requests := r.requests
+	r.mu.Unlock()
+	time.Sleep(40 * time.Millisecond)
+	r.mu.Lock()
+	after := r.requests
+	r.mu.Unlock()
+	require.Equal(t, requests, after, "polling continued after Close")
+	once.Do(func() { close(release) })
+	require.NoError(t, resultWithin(t, callback))
+	require.NoError(t, s.Close())
+}
