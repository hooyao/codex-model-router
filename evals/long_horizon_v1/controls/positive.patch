+func TestOCIReferencesPassThroughFactory(t *testing.T) {
+	dir := t.TempDir()
+	builder, err := oci.NewStore(zap.NewNop(), dir)
+	require.NoError(t, err)
+	makeBundle := func(tag, key string) {
+		ref, err := oci.ParseReference("flipt://local/features:" + tag)
+		require.NoError(t, err)
+		_, err = builder.Build(context.Background(), fstest.MapFS{"features.yml": &fstest.MapFile{
+			Data: []byte(`{"namespace":"production","flags":[{"key":"` + key + `","name":"Flag"}]}`), Mode: 0444}}, ref)
+		require.NoError(t, err)
+	}
+	makeBundle("stable", "old")
+	makeBundle("latest", "new")
+	var cfg config.Config
+	cfg.Storage.Type = config.OCIStorageType
