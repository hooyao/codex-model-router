+	defer cancel()
+	store, err := NewStore(ctx, zap.NewNop(), &cfg)
+	require.NoError(t, err)
+	for _, test := range []struct{ ref, key string }{{"", "new"}, {"stable", "old"}} {
+		req := storage.NewResource("production", test.key)
+		req.Reference = storage.Reference(test.ref)
+		flag, err := store.GetFlag(ctx, req)
+		require.NoError(t, err)
+		require.Equal(t, test.key, flag.Key)
+	}
+	req := storage.NewResource("production", "new")
+	req.Reference = "another/repository:latest"
+	_, err = store.GetFlag(ctx, req)
+	require.Error(t, err)
+}
