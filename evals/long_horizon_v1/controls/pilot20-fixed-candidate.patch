@@ -0,0 +1,197 @@
+package oci
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	"go.flipt.io/flipt/internal/storage"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap/zaptest"
+	"oras.land/oras-go/v2"
+)
+
+func openSnapshotSource(t *testing.T, dir, repo string) *SnapshotStore {
+	t.Helper()
+	store, err := fliptoci.NewStore(zaptest.NewLogger(t), dir)
+	require.NoError(t, err)
+	ref, err := fliptoci.ParseReference(fmt.Sprintf("flipt://local/%s:latest", repo))
+	require.NoError(t, err)
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	source, err := NewSnapshotStore(ctx, zaptest.NewLogger(t), store, ref,
+		WithPollOptions(storagefs.WithInterval(time.Hour)))
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, source.Close()) })
+	return source
+}
+
+func hasFlag(t *testing.T, source *SnapshotStore, ref storage.Reference, key string) bool {
+	t.Helper()
+	ctx := context.Background()
+	found := false
+	require.NoError(t, source.View(ctx, ref, func(snapshot storage.ReadOnlyStore) error {
+		_, err := snapshot.GetFlag(ctx, storage.NewResource("production", key))
+		found = err == nil
+		return nil
+	}))
+	return found
+}
+
+func TestReferenceSelectionAndTagMovement(t *testing.T) {
+	ctx := context.Background()
+	target, dir, repo := testRepository(t,
+		layer("production", `{"namespace":"production","flags":[{"key":"old","name":"Old"}]}`, fliptoci.MediaTypeFliptNamespace))
+	old, err := target.Resolve(ctx, "latest")
+	require.NoError(t, err)
+	require.NoError(t, target.Tag(ctx, old, "stable"))
+	updateRepoContents(t, target,
+		layer("production", `{"namespace":"production","flags":[{"key":"new","name":"New"}]}`, fliptoci.MediaTypeFliptNamespace))
+	newManifest, err := target.Resolve(ctx, "latest")
+	require.NoError(t, err)
+	source := openSnapshotSource(t, dir, repo)
+
+	require.True(t, hasFlag(t, source, "", "new"))
+	require.False(t, hasFlag(t, source, "", "old"))
+	require.True(t, hasFlag(t, source, "stable", "old"))
+	require.True(t, hasFlag(t, source, storage.Reference(old.Digest.String()), "old"))
+	require.True(t, hasFlag(t, source, storage.Reference(newManifest.Digest.String()), "new"))
+
+	require.NoError(t, target.Tag(ctx, newManifest, "stable"))
+	require.True(t, hasFlag(t, source, "stable", "new"), "a later tag view resolves the moved tag")
+	require.False(t, hasFlag(t, source, "stable", "old"))
+	require.True(t, hasFlag(t, source, storage.Reference(old.Digest.String()), "old"), "manifest digest remains immutable")
+	require.True(t, hasFlag(t, source, "", "new"))
+}
+
+func TestReferenceRejectsRepositoryAndTransportChanges(t *testing.T) {
+	source, _ := testStore(t, WithPollOptions(storagefs.WithInterval(time.Hour)))
+	for _, ref := range []storage.Reference{
+		"https://other.example/repo:tag", "http://other.example/repo:tag",
+		"flipt://local/other:tag", "other/repo:tag", "testrepo:latest",
+		"sha256:abc", "sha512:" + storage.Reference(strings.Repeat("a", 128)),
+		"latest?transport=http", "latest@sha256:" + storage.Reference(strings.Repeat("a", 64)),
+	} {
+		t.Run(string(ref), func(t *testing.T) {
+			called := false
+			err := source.View(context.Background(), ref, func(storage.ReadOnlyStore) error {
+				called = true
+				return nil
+			})
+			require.Error(t, err)
+			require.False(t, called)
+		})
+	}
+}
+
+func TestViewAfterCloseReturnsErrClosedForEverySelector(t *testing.T) {
+	source, _ := testStore(t, WithPollOptions(storagefs.WithInterval(time.Hour)))
+	require.NoError(t, source.Close())
+
+	for name, ref := range map[string]storage.Reference{
+		"empty":            "",
+		"valid tag":        "latest",
+		"unknown tag":      "not-present",
+		"valid digest":     storage.Reference("sha256:" + strings.Repeat("0", 64)),
+		"malformed digest": "sha256:abc",
+		"invalid selector": "other/repo:tag",
+	} {
+		t.Run(name, func(t *testing.T) {
+			called := false
+			err := source.View(context.Background(), ref, func(storage.ReadOnlyStore) error {
+				called = true
+				return nil
+			})
+			require.ErrorIs(t, err, ErrClosed)
+			require.False(t, called)
+		})
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.ErrorIs(t, source.View(ctx, "sha256:abc", func(storage.ReadOnlyStore) error {
+		t.Fatal("callback must not run")
+		return nil
+	}), context.Canceled)
+}
+
+func TestReferenceCacheBoundAndActiveView(t *testing.T) {
+	ctx := context.Background()
+	target, dir, repo := testRepository(t,
+		layer("production", `{"namespace":"production","flags":[{"key":"old","name":"Old"}]}`, fliptoci.MediaTypeFliptNamespace))
+	manifest, err := target.Resolve(ctx, "latest")
+	require.NoError(t, err)
+	for i := 0; i < 5; i++ {
+		require.NoError(t, target.Tag(ctx, manifest, fmt.Sprintf("tag-%d", i)))
+	}
+	source := openSnapshotSource(t, dir, repo)
+
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	result := make(chan error, 1)
+	go func() {
+		result <- source.View(ctx, "tag-0", func(snapshot storage.ReadOnlyStore) error {
+			close(entered)
+			<-release
+			_, err := snapshot.GetFlag(ctx, storage.NewResource("production", "old"))
+			return err
+		})
+	}()
+	select {
+	case <-entered:
+	case err := <-result:
+		t.Fatalf("view failed before callback: %v", err)
+	case <-time.After(10 * time.Second):
+		t.Fatal("timed out waiting for active view")
+	}
+	for i := 1; i < 5; i++ {
+		require.True(t, hasFlag(t, source, storage.Reference(fmt.Sprintf("tag-%d", i)), "old"))
+	}
+	source.mu.Lock()
+	extraCount := len(source.extras)
+	_, evicted := source.extras["tag-0"]
+	defaultSnapshot := source.defaultSnapshot
+	source.mu.Unlock()
+	require.Equal(t, referenceCacheExtraCapacity, extraCount)
+	require.False(t, evicted)
+	require.NotNil(t, defaultSnapshot)
+	close(release)
+	require.NoError(t, <-result, "eviction cannot invalidate an active callback")
+	require.True(t, hasFlag(t, source, "", "old"))
+}
+
+func TestDefaultPollTracksCompleteManifestDigest(t *testing.T) {
+	ctx := context.Background()
+	target, dir, repo := testRepository(t,
+		layer("production", `{"namespace":"production","flags":[{"key":"old","name":"Old"}]}`, fliptoci.MediaTypeFliptNamespace))
+	source := openSnapshotSource(t, dir, repo)
+	old, err := target.Resolve(ctx, "latest")
+	require.NoError(t, err)
+	reader, err := target.Fetch(ctx, old)
+	require.NoError(t, err)
+	var manifest v1.Manifest
+	require.NoError(t, json.NewDecoder(reader).Decode(&manifest))
+	require.NoError(t, reader.Close())
+	newer, err := oras.PackManifest(ctx, target, oras.PackManifestVersion1_1_RC4,
+		fliptoci.MediaTypeFliptFeatures, oras.PackManifestOptions{
+			ManifestAnnotations: map[string]string{"revision": "annotation-only"},
+			Layers:              manifest.Layers,
+		})
+	require.NoError(t, err)
+	require.NotEqual(t, old.Digest, newer.Digest)
+	require.NoError(t, target.Tag(ctx, newer, "latest"))
+	changed, err := source.update(ctx)
+	require.NoError(t, err)
+	require.True(t, changed)
+	source.mu.Lock()
+	got := source.defaultManifest
+	source.mu.Unlock()
+	require.Equal(t, newer.Digest, got)
+	require.True(t, hasFlag(t, source, "", "old"))
+}
